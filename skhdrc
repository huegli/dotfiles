# --- Changing Focus ---
# change window focus within space
ctrl + cmd + alt - u : yabai -m window --focus south
ctrl + cmd + alt - a : yabai -m window --focus north
ctrl + cmd + alt - o : yabai -m window --focus west
ctrl + cmd + alt - e : yabai -m window --focus east

# change focus to display left and right
ctrl + cmd + alt - g: yabai -m display --focus west
ctrl + cmd + alt - c: yabai -m display --focus east

# --- Modify Layout ---

# balance out tree 
ctrl + cmd + alt - f : yabai -m space --balance

# rotate layout clockwise
ctrl + cmd + alt - d : yabai -m space --rotate 270

# flip along y-axis
ctrl + cmd + alt - r : yabai -m space --mirror y-axis

# flip along x-axis
ctrl + cmd + alt - l : yabai -m space --mirror x-axis

# --- Moving Windows Arround ---

# swap windows within space
hyper - u : yabai -m window --swap south
hyper - a : yabai -m window --swap north
hyper - o : yabai -m window --swap west
hyper - e : yabai -m window --swap east

# maximize a window
ctrl + cmd + alt - p : yabai -m window --toggle zoom-fullscreen

# toggle window float
ctrl + cmd + alt - y : yabai -m window --toggle float --grid 4:4:1:1:2:2

# move window and split
ctrl + cmd + alt - s : yabai -m window --warp south
ctrl + cmd + alt - h : yabai -m window --warp north
ctrl + cmd + alt - t : yabai -m window --warp west
ctrl + cmd + alt - n : yabai -m window --warp east

# move window to display left and right
hyper - g : yabai -m window --display west; yabai -m display --focus west;
hyper - c : yabai -m window --display east; yabai -m display --focus east;

